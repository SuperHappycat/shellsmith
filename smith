#!/usr/bin/env python3
"""smith — the Shellsmith command-line companion.

  ./smith setup      create your GitHub repo, turn on the dashboard, first push
  ./smith test       run the tests on this computer (fast feedback)
  ./smith test -w    watch mode: re-run every time you save a file
  ./smith test 12    run only stage 12 (also: --seed S to replay a run, --jobs N)
  ./smith submit     commit + push, then stream the official GitHub run back here
  ./smith stage [N]  show instructions for the current stage (or stage N)
  ./smith stages     list every stage and your progress
  ./smith status     local and remote progress at a glance
  ./smith language   list languages; ./smith language go switches your starter code
  ./smith open       open your dashboard website
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
import webbrowser

ROOT = os.path.dirname(os.path.abspath(__file__))
STATE = os.path.join(ROOT, ".smith")
LAST = os.path.join(STATE, "last.json")
WORKFLOW = "smith.yml"
TEST_STEP = "Run the tester"

sys.path.insert(0, os.path.join(ROOT, "tester"))
from run import load_course  # noqa: E402

COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def c(code, text):
    return f"\033[{code}m{text}\033[0m" if COLOR else text


bold = lambda t: c("1", t)
dim = lambda t: c("90", t)
green = lambda t: c("32", t)
red = lambda t: c("31", t)
cyan = lambda t: c("36", t)
yellow = lambda t: c("33", t)


def die(msg):
    print(red("error: ") + msg)
    sys.exit(1)


def sh(*args, check=True, capture=True):
    r = subprocess.run(args, cwd=ROOT, text=True,
                       stdout=subprocess.PIPE if capture else None,
                       stderr=subprocess.PIPE if capture else None)
    if check and r.returncode != 0:
        die(f"`{' '.join(args)}` failed:\n{(r.stderr or r.stdout or '').strip()}")
    return (r.stdout or "").strip() if capture else r.returncode


# ------------------------------------------------------------------ git/GitHub helpers
def repo_slug():
    r = subprocess.run(["git", "remote", "get-url", "origin"], cwd=ROOT, capture_output=True, text=True)
    if r.returncode != 0:
        return None
    url = r.stdout.strip()
    m = re.search(r"github\.com[:/]([^/]+)/([^/]+?)(?:\.git)?/?$", url)
    return (m.group(1), m.group(2)) if m else None


def dashboard_url(slug):
    owner, repo = slug
    host = f"{owner.lower()}.github.io"
    return f"https://{host}/" if repo.lower() == host else f"https://{host}/{repo}/"


def have_gh():
    return shutil.which("gh") and subprocess.run(["gh", "auth", "status"], capture_output=True).returncode == 0


def api(path):
    req = urllib.request.Request(f"https://api.github.com{path}",
                                 headers={"Accept": "application/vnd.github+json", "User-Agent": "smith-cli"})
    tok = os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN")
    if tok:
        req.add_header("Authorization", f"Bearer {tok}")
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def gh_json(*args):
    return json.loads(sh("gh", *args))


# ------------------------------------------------------------------ course helpers
def last_results():
    try:
        with open(LAST) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def current_index(course):
    last = last_results()
    if last and last.get("current"):
        for i, s in enumerate(course):
            if s["slug"] == last["current"]:
                return i
    if last and last.get("passed") == len(course):
        return len(course)
    return 0 if not last else min(last.get("passed") or 0, len(course))


def render_md(text):
    out, in_code = [], False
    for line in text.splitlines():
        if line.startswith("```"):
            in_code = not in_code
            continue
        if in_code:
            out.append("    " + cyan(line))
        elif line.startswith("#"):
            out.append("\n" + bold(yellow(line.lstrip("# "))))
        else:
            line = re.sub(r"\*\*(.+?)\*\*", lambda m: bold(m.group(1)), line)
            line = re.sub(r"`([^`]+)`", lambda m: cyan(m.group(1)), line)
            out.append(line)
    return "\n".join(out)


# ------------------------------------------------------------------ commands
IGNORE_DIRS = {".git", ".smith", "tester", "course", "site", "scripts", "_site", "__pycache__", ".github"}


def source_snapshot():
    snap = {}
    for dirpath, dirs, files in os.walk(ROOT):
        dirs[:] = [d for d in dirs if d not in IGNORE_DIRS and not d.startswith(".")]
        for f in files:
            p = os.path.join(dirpath, f)
            try:
                snap[p] = os.stat(p).st_mtime_ns
            except OSError:
                pass
    return snap


def run_tests(stage, extra):
    os.makedirs(STATE, exist_ok=True)
    out = os.path.join(STATE, "single.json") if stage else LAST
    cmd = [sys.executable, os.path.join(ROOT, "tester", "run.py"), "--json", out] + extra
    if stage:
        cmd += ["--only", stage]
    return subprocess.call(cmd, cwd=ROOT)


def cmd_test(args):
    """./smith test [STAGE] [--watch] [--seed S] [--jobs N]"""
    watch = "--watch" in args or "-w" in args
    args = [a for a in args if a not in ("--watch", "-w")]
    extra, stage, i = [], None, 0
    while i < len(args):
        if args[i] in ("--seed", "--jobs") and i + 1 < len(args):
            extra += args[i:i + 2]
            i += 2
        else:
            stage = args[i]
            i += 1
    if not watch:
        code = run_tests(stage, extra)
        if not stage and code == 0:
            print(dim("Ship it to GitHub with:  ./smith submit"))
        sys.exit(code)
    snap = None
    while True:
        new = source_snapshot()
        if new != snap:
            snap = new
            if COLOR:
                print("\033[2J\033[H", end="")
            print(dim(time.strftime("%H:%M:%S") + "  running tests (save a file to re-run, Ctrl-C to stop)\n"))
            run_tests(stage, extra)
        time.sleep(0.5)


def cmd_stage(args):
    course = load_course()
    if args:
        key = args[0]
        found = [s for s in course if key in (s["slug"], str(s["number"]))]
        if not found:
            die(f"No stage {key!r}. See ./smith stages")
        s = found[0]
    else:
        i = current_index(course)
        if i >= len(course):
            print(green("All stages done. 🎉"))
            return
        s = course[i]
    print(bold(f"Stage {s['number']}/{len(course)} · {s['title'].replace('`', '')}") + dim(f"   [{s['chapter']} · {s['difficulty']}]"))
    print(render_md(s["body"]))
    print(dim("\nWhen you're ready:  ./smith test     then   ./smith submit"))


def cmd_stages(_):
    course = load_course()
    cur = current_index(course)
    chapter = None
    for i, s in enumerate(course):
        if s["chapter"] != chapter:
            chapter = s["chapter"]
            print("\n" + bold(chapter))
        mark = green("✔") if i < cur else (yellow("➜") if i == cur else dim("·"))
        t = re.sub(r"`([^`]+)`", lambda m: cyan(m.group(1)), s["title"])
        title = bold(t) if i == cur else (t if i < cur else dim(s["title"].replace("`", "")))
        print(f"  {mark} {s['number']:>2}. {title}")
    print(f"\n{min(cur, len(course))}/{len(course)} stages passed (from your last ./smith test)")


def find_run(slug, sha, timeout=90):
    owner, repo = slug
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            if have_gh():
                runs = gh_json("run", "list", "-R", f"{owner}/{repo}", "--commit", sha, "--workflow", WORKFLOW,
                               "--json", "databaseId,status,conclusion,url", "--limit", "1")
                if runs:
                    return runs[0]["databaseId"], runs[0]["url"]
            else:
                data = api(f"/repos/{owner}/{repo}/actions/runs?head_sha={sha}&per_page=5")
                for r in data.get("workflow_runs", []):
                    if r["path"].endswith(WORKFLOW):
                        return r["id"], r["html_url"]
        except (urllib.error.URLError, SystemExit, ValueError):
            pass
        time.sleep(3)
    return None, None


def watch_run(slug, run_id):
    owner, repo = slug
    seen = set()
    spinner = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
    k = 0
    while True:
        try:
            if have_gh():
                data = gh_json("run", "view", str(run_id), "-R", f"{owner}/{repo}", "--json", "status,conclusion,jobs")
                jobs = data["jobs"]
                status = data["status"]
                steps = [(j["name"], s["name"], s["status"], s["conclusion"]) for j in jobs for s in j.get("steps", [])]
            else:
                data = api(f"/repos/{owner}/{repo}/actions/runs/{run_id}")
                status = data["status"]
                jobs = api(f"/repos/{owner}/{repo}/actions/runs/{run_id}/jobs")["jobs"]
                steps = [(j["name"], s["name"], s["status"], s["conclusion"]) for j in jobs for s in j.get("steps", [])]
        except (urllib.error.URLError, SystemExit, ValueError, KeyError):
            time.sleep(3)
            continue
        for job, step, st, concl in steps:
            key = (job, step)
            if st == "completed" and key not in seen:
                seen.add(key)
                icon = green("✔") if concl in ("success", "skipped") else red("✘")
                print(f"\r  {icon} {dim(job + ' ›')} {step}" + " " * 10)
        if status == "completed":
            return
        k += 1
        print(f"\r  {cyan(spinner[k % len(spinner)])} {dim('GitHub is ' + status.replace('_', ' ') + '…')}", end="", flush=True)
        time.sleep(2)


def print_remote_log(slug, run_id):
    owner, repo = slug
    if have_gh():
        try:
            log = sh("gh", "run", "view", str(run_id), "-R", f"{owner}/{repo}", "--log")
        except SystemExit:
            log = ""
        lines = []
        for line in log.splitlines():
            parts = line.split("\t", 2)
            if len(parts) == 3 and parts[1] == TEST_STEP:
                text = re.sub(r"^\S+Z ", "", parts[2])
                if not text.startswith("##[") and not text.startswith("\x1b[36;1m"):
                    lines.append(text)
        if lines:
            print(bold("\n── Test output from GitHub ──"))
            print("\n".join(lines))
            return True
    # No gh: read the results file the dashboard publishes.
    url = dashboard_url(slug) + "results.json"
    print(dim(f"\nWaiting for the dashboard to publish results ({url})…"))
    sha = sh("git", "rev-parse", "HEAD")
    for _ in range(40):
        try:
            with urllib.request.urlopen(f"{url}?t={time.time()}", timeout=15) as r:
                data = json.load(r)
            if data.get("commit") == sha:
                print(bold("\n── Test output from GitHub ──"))
                for res in data["results"]:
                    for l in res["log"]:
                        col = {"ok": green, "fail": red, "shell": yellow, "dim": dim}.get(l["kind"], cyan)
                        print(col(l["text"]))
                return True
        except (urllib.error.URLError, ValueError):
            pass
        time.sleep(5)
    print(yellow("Results not published yet; check the dashboard in a minute."))
    return False


def cmd_submit(args):
    slug = repo_slug()
    if not slug:
        die("This folder isn't connected to a GitHub repo yet. Run:  ./smith setup")
    msg = " ".join(args) or "smith submit"
    sh("git", "add", "-A")
    if sh("git", "status", "--porcelain"):
        sh("git", "commit", "-q", "-m", msg)
        print(green("✔") + f" Committed: {msg}")
    else:
        print(dim("No changes to commit; re-running tests on the latest commit."))
        sh("git", "commit", "-q", "--allow-empty", "-m", msg)
    print(dim("Pushing to GitHub…"))
    if sh("git", "push", "-q", "origin", "HEAD", check=False, capture=False) != 0:
        die("git push failed (see above).")
    sha = sh("git", "rev-parse", "HEAD")
    print(green("✔") + f" Pushed {sha[:7]} to {slug[0]}/{slug[1]}")
    run_id, url = find_run(slug, sha)
    if not run_id:
        die("GitHub didn't start a test run. Is Actions enabled for the repo? "
            f"Check https://github.com/{slug[0]}/{slug[1]}/actions")
    print(dim(f"Connected to run {url}"))
    watch_run(slug, run_id)
    print_remote_log(slug, run_id)
    print("\n" + bold("Dashboard: ") + dashboard_url(slug) + dim("  (updates about a minute after each run)"))


def cmd_status(_):
    course = load_course()
    cur = current_index(course)
    print(bold("Local:  ") + f"{min(cur, len(course))}/{len(course)} stages passed")
    if cur < len(course):
        print(bold("Next:   ") + f"stage {course[cur]['number']} · {course[cur]['title']}")
    slug = repo_slug()
    if not slug:
        print(dim("Not connected to GitHub yet (./smith setup)."))
        return
    try:
        with urllib.request.urlopen(f"{dashboard_url(slug)}results.json?t={time.time()}", timeout=10) as r:
            data = json.load(r)
        print(bold("GitHub: ") + f"{data.get('passed')}/{data.get('total')} stages passed "
              + dim(f"(commit {str(data.get('commit'))[:7]}, {data.get('generated_at')})"))
    except (urllib.error.URLError, ValueError):
        print(bold("GitHub: ") + dim("no published results yet"))
    print(bold("Site:   ") + dashboard_url(slug))


def cmd_open(_):
    slug = repo_slug()
    if not slug:
        die("Not connected to GitHub yet. Run:  ./smith setup")
    url = dashboard_url(slug)
    print(url)
    webbrowser.open(url)


def cmd_setup(args):
    if not shutil.which("git"):
        die("git is not installed.")
    if not shutil.which("gh"):
        die("setup uses the GitHub CLI. Install it from https://cli.github.com then run:  gh auth login")
    if subprocess.run(["gh", "auth", "status"], capture_output=True).returncode != 0:
        die("You're not logged in to the GitHub CLI. Run:  gh auth login")
    os.chmod(os.path.join(ROOT, "your_shell.sh"), 0o755)
    if not os.path.isdir(os.path.join(ROOT, ".git")):
        sh("git", "init", "-q", "-b", "main")
        print(green("✔") + " Created a git repository")
    sh("git", "add", "-A")
    if sh("git", "status", "--porcelain"):
        sh("git", "commit", "-q", "-m", "Start Shellsmith")
    slug = repo_slug()
    if not slug:
        name = args[0] if args else os.path.basename(ROOT)
        print(dim(f"Creating public GitHub repo '{name}'…"))
        sh("gh", "repo", "create", name, "--public", "--source", ".", "--remote", "origin",
           "--description", "My shell, built stage by stage with Shellsmith")
        slug = repo_slug()
        print(green("✔") + f" Created github.com/{slug[0]}/{slug[1]}")
    owner, repo = slug
    r = subprocess.run(["gh", "api", "-X", "POST", f"repos/{owner}/{repo}/pages", "-f", "build_type=workflow"],
                       capture_output=True, text=True)
    if r.returncode != 0 and "409" not in (r.stderr + r.stdout) and "already" not in (r.stderr + r.stdout):
        subprocess.run(["gh", "api", "-X", "PUT", f"repos/{owner}/{repo}/pages", "-f", "build_type=workflow"],
                       capture_output=True)
    print(green("✔") + " Dashboard website enabled (GitHub Pages)")
    sh("git", "push", "-q", "-u", "origin", "HEAD", capture=False)
    print(green("✔") + " Pushed. GitHub is running the tests now.")
    print("\n" + bold("Your dashboard: ") + dashboard_url(slug))
    print("Next:  " + cyan("./smith stage") + "  to read stage 1.")


LANGS = {"python": "Python 3", "c": "C (with GNU readline)", "go": "Go", "rust": "Rust",
         "javascript": "JavaScript (Node.js)"}


def current_language():
    exts = {"main.py": "python", "main.c": "c", "main.go": "go", "Cargo.toml": "rust", "main.js": "javascript"}
    app = os.path.join(ROOT, "app")
    found = [lang for f, lang in exts.items() if os.path.exists(os.path.join(app, f))]
    return found[0] if len(found) == 1 else None


def cmd_language(args):
    cur = current_language()
    if not args:
        print(bold("Languages") + dim("  (switch with ./smith language NAME)"))
        for k, v in LANGS.items():
            print(f"  {green('➜') if k == cur else ' '} {k:<11} {v}")
        return
    lang = args[0].lower()
    if lang not in LANGS:
        die(f"unknown language {lang!r}. Choose from: {', '.join(LANGS)}")
    if lang == cur:
        print(f"You're already using {LANGS[lang]}.")
        return
    src = os.path.join(ROOT, "starters", lang)
    app = os.path.join(ROOT, "app")
    if os.path.isdir(app) and os.listdir(app):
        backup = os.path.join(STATE, "backup-" + time.strftime("%Y%m%d-%H%M%S"))
        os.makedirs(backup, exist_ok=True)
        shutil.move(app, os.path.join(backup, "app"))
        for f in ("your_shell.sh", "build.sh"):
            if os.path.exists(os.path.join(ROOT, f)):
                shutil.copy2(os.path.join(ROOT, f), backup)
        print(dim(f"Your previous code is saved in {os.path.relpath(backup, ROOT)}/"))
    shutil.copytree(os.path.join(src, "app"), app)
    shutil.copy2(os.path.join(src, "your_shell.sh"), os.path.join(ROOT, "your_shell.sh"))
    build = os.path.join(ROOT, "build.sh")
    if os.path.exists(os.path.join(src, "build.sh")):
        shutil.copy2(os.path.join(src, "build.sh"), build)
    elif os.path.exists(build):
        os.remove(build)
    print(green("✔") + f" Switched to {LANGS[lang]}. Your code goes in app/. Start with ./smith stage")


COMMANDS = {"test": cmd_test, "submit": cmd_submit, "stage": cmd_stage, "stages": cmd_stages,
            "status": cmd_status, "open": cmd_open, "setup": cmd_setup,
            "language": cmd_language}


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    fn = COMMANDS.get(sys.argv[1])
    if not fn:
        die(f"unknown command {sys.argv[1]!r}. Try ./smith help")
    try:
        fn(sys.argv[2:])
    except KeyboardInterrupt:
        print()


if __name__ == "__main__":
    main()
